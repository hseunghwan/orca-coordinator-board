{
  "manifestVersion": 2,
  "id": "coordinator-board",
  "name": "Coordinator Board",
  "version": "0.6.3",
  "description": "Group agent sessions by project and answer the ones waiting for you, from a sidebar panel or a full-width dashboard tab.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/worker.mjs",
  "contributes": {
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.removed"
      }
    ],
    "panels": [
      {
        "id": "coordinator-board",
        "title": "Coordinator Board",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "customEditors": [
      {
        "id": "dashboard",
        "title": "Coordinator Board",
        "extensions": [
          ".coordinator-board"
        ],
        "entry": "dist/dashboard.html",
        "frame": "isolated"
      }
    ],
    "commands": [
      {
        "id": "open-dashboard",
        "title": "Coordinator Board: Open dashboard"
      }
    ],
    "statusBarItems": [
      {
        "id": "waiting",
        "text": "Board",
        "icon": "blocks",
        "tooltip": "Coordinator Board",
        "command": "open-dashboard"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "history:read"
    }
  ]
}
