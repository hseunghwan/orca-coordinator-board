{
  "manifestVersion": 2,
  "id": "coordinator-board",
  "name": "Coordinator Board",
  "version": "0.1.0",
  "description": "Group agent sessions by project and answer the ones waiting for you from one panel.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "coordinator-board",
        "title": "Coordinator Board",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "workspace:write"
    }
  ]
}
